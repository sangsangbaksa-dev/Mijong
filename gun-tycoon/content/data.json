{
  "version": 2,
  "meta": {
    "title": "총 타이쿤",
    "targetPlaytimeMin": 120,
    "loop": "낮(자원 채집) → 밤(몬스터 처치) → 허브(상점·건설·스킬트리) → 다음 날. 허브의 '보스에 도전하기'로 보스를 이기면 엔딩",
    "currencies": {
      "gold": "골드: 밤 처치·보급 상자·무기 노점",
      "scrap": "고철: 낮 채집·고철 분쇄기",
      "crystal": "크리스탈: 엘리트 처치·빛나는 결정(6일차부터 하루 1개)",
      "sp": "스킬 포인트: 하루 1, 엘리트 처치 1"
    }
  },
  "formulas": {
    "nightMonsterStat": "monster.hp * hpGrowthPerDay^(day-1), dmg * dmgGrowthPerDay^(day-1), gold * goldGrowthPerDay^(day-1)",
    "nightSpawnCount": "baseCount + countPerDay*(day-1), 해금된 몬스터 중 weight 비율로 뽑기",
    "eliteHp": "그날 몬스터 평균 체력 * eliteHpMult (elites[].base 몬스터 모습)",
    "gunDamage": "gun.dmg * (1 + 0.12*화력강화Lv) * 스킬 dmgMult",
    "gunFireRate": "gun.fireRate * (1 + 0.06*연사개조Lv) * 스킬 rateMult",
    "magazine": "gun.magazine * (1 + 0.10*확장탄창Lv), reload = reloadSec * (1 - 0.04*확장탄창Lv)",
    "crit": "확률 5% + 스킬 + 조명탑 3%/개, 치명 피해 x2 (+스킬 critDmg)",
    "playerHp": "(100 + 25*방탄조끼Lv + 스킬 hpFlat) * 스킬 hpMult, 방어 = 4*방탄조끼Lv + 스킬 armorFlat",
    "upgradeCost": "cost[통화] = [base, growth] → base * growth^현재레벨 (건물은 현재 개수)",
    "dailyGather": "낮 채집은 맵 자원 지점 수집. 채집 속도 = 1 * (1+0.15*채집도구Lv) * 스킬 gatherMult (gatherSec 나누기)",
    "morningProduction": "고철 분쇄기 30고철/개, 무기 노점 120*1.15^(day-1) 골드/개, 스킬 buildingMult 적용",
    "turretDps": "25 * 개수 * (1 + 0.12*화력강화Lv) * 1.35^포탑개량Lv"
  },
